<!DOCTYPE RCC>
<RCC version="1.0">
    <!--
        The Qt Quick Test suite files, and nothing else.

        The shipping QML reaches these binaries through the top-level
        resources.qrc, which every target listing this file also lists. This
        file used to carry its own aliased copy of that list, so a new QML
        component had to be written into two places that nothing compared: a
        component added only to resources.qrc loaded in the application and
        was missing from the test binaries, where it surfaced as every block
        delegate failing to instantiate rather than as anything naming the
        real cause.
    -->
    <qresource prefix="/">
        <file>tst_integration.qml</file>
        <file>tst_visual.qml</file>
    </qresource>
</RCC>
